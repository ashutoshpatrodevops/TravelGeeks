<% layout("/layouts/boilerplate") %>
<head>
  <link rel="stylesheet" href="https://unpkg.com/starability@2.4.0/starability-css/starability-all.css">
</head>
<script>
  const coordinates = <%- JSON.stringify(listing.geometry.coordinates.reverse()) %>;
  const content = <%- JSON.stringify(listing.title) %>
</script>
<body>
  <div class="container my-5">
    <!-- Listing Info Card -->
    <div class="row justify-content-center">
      <div class="col-md-8 col-lg-7">
        <h3 class="mb-4"><%= listing.title %></h3>
        <div class="p-4 bg-white rounded shadow-sm">
          <img src="<%= listing.image.url %>" alt="<%= listing.title %>" class="img-fluid mb-3 detail-img">
          <div class="d-flex justify-content-between align-items-center mb-2">
  <h5 class="card-title mb-0"><b><%= listing.title %></b></h5>
  <span class="category-badge"><%= listing.category %></span>
</div>

          <i>Owned By: <%=listing.owner.username %></i>
          <br><br>
          <div class="mb-2" style="color: #444;"><%= listing.description %></div>
          <div class="mb-1">₹<%= listing.price.toLocaleString("en-IN") %></div>
          <div class="mb-1"><%= listing.location %></div>
          <div class="mb-3"><%= listing.country %></div>
         
          <div class="d-flex gap-2">
            <% if(currUser && listing.owner._id.equals(currUser._id)){ %>
              <a href="/listings/<%= listing._id %>/edit" class="btn btn-danger px-4">Edit</a>
              <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST" class="m-0">
                <button type="submit" class="btn btn-dark px-4">Delete</button>
              </form>
            <% } %>
          </div>
        </div>
      </div>
    </div>


    <!-- Review Section (Outside Listing Card) -->
    <% if(currUser) { %>
      <div class="row justify-content-center mt-5">
        <div class="col-md-8 col-lg-7">
          <div class="p-4 bg-white rounded shadow-sm">
            <h3>Leave your Reviews</h3>
            <form action="/listings/<%= listing._id %>/reviews" method="POST">
              <div class="mb-3">
                <label for="rating" class="form-label">Rating</label>
                <fieldset class="starability-slot">
  <input type="radio" id="first-rate1" name="review[rating]" value="1" />
  <label for="first-rate1" title="Terrible">1 star</label>
  <input type="radio" id="first-rate2" name="review[rating]" value="2" />
  <label for="first-rate2" title="Not good">2 stars</label>
  <input type="radio" id="first-rate3" name="review[rating]" value="3" />
  <label for="first-rate3" title="Average">3 stars</label>
  <input type="radio" id="first-rate4" name="review[rating]" value="4" />
  <label for="first-rate4" title="Very good">4 stars</label>
  <input type="radio" id="first-rate5" name="review[rating]" value="5" />
  <label for="first-rate5" title="Amazing">5 stars</label>  
</fieldset>
</div>
            </div>   
              <div class="mb-3">
                <label for="comment" class="form-label fw-bold">Comments</label>
                <textarea name="review[comment]" id="comment" novalidate class="form-control" rows="4" cols="30" required></textarea>
              </div>
              <button type="submit" class="btn btn-outline-dark px-4">Submit</button>
            </form>
          </div>
        </div>
      </div>
      <br>
    <% } %>    
    <br>
    <!-- All Reviews Section -->
     <% if(listing.reviews.length>0) {%>
    <div class="row justify-content-center">
      <div class="col-md-8 col-lg-7">
        <h4 class="mb-3">All Reviews</h4>
        <div class="row">
          <% for(let review of listing.reviews) { %>
            <div class="col-md-6 mb-3 d-flex align-items-stretch">
              <div class="card shadow-sm w-100">
                <div class="card-body">
                  <h5 class="card-title"><%= review.author.username %></h5>
                  <p class="card-text"><strong>Comment:</strong> <%= review.comment %></p>
                  <p class="starability-result card-text" data-rating="<%= review.rating %>"></p>
                </div>
                <form class="mb-3 px-3" method="POST" action="/listings/<%= listing._id%>/reviews/<%= review._id %>?_method=DELETE">
                  <button class="btn btn-sm btn-dark">Delete</button>
                </form>
              </div>
            </div>
          <% } %>
        </div>
      </div>
    </div>
    <% } %>
    <div class="row justify-content-center">
      <div class="col-md-8 col-lg-7">
        <h4>Where You'll be</h4>
        <div id="map">

        </div>
        </div>
        </div>
  </div>
  <script src="/js/map.js"></script>
</body>